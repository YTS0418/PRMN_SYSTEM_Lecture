' Binder の役割（08 章）
@startuml dia-08-01-binder
!include _common.iuml
left to right direction
rectangle "画面（入力欄）" as form #d6eaf8 {
  rectangle "TextField\n氏名" as f1 #white
  rectangle "IntegerField\n入学年度" as f2 #white
}
rectangle "Binder\n・値の受け渡し\n・変換\n・入力チェック" as b #fffbe6
rectangle "データ（Java のオブジェクト）" as bean #d5f5e3 {
  rectangle "氏名" as o1 #white
  rectangle "入学年度" as o2 #white
}
f1 <--> b
f2 <--> b
b <--> o1
b <--> o2
@enduml
