' 資料の構成（00 章）：第 1 部 → 第 2 部 → 付録
@startuml dia-00-01-structure
!include _common.iuml
top to bottom direction
rectangle "第 1 部　基本（01〜09 章）" as A #d6eaf8 {
  rectangle "01〜02\n準備" as a1 #white
  rectangle "03〜05\n画面を作る" as a2 #white
  rectangle "06〜08\n動かす・一覧・フォーム" as a3 #white
  rectangle "09\n4層とつなぐ" as a4 #white
  a1 -right-> a2
  a2 -right-> a3
  a3 -right-> a4
}
rectangle "第 2 部　応用（10〜13 章）" as B #d5f5e3 {
  rectangle "10〜11\nログイン" as b1 #white
  rectangle "12\n脅威と対策" as b2 #white
  rectangle "13\nテーマ" as b3 #white
  b1 -right-> b2
  b2 -right-> b3
}
rectangle "付録（A1〜A4）" as C #fff3cd {
  rectangle "テスト・本番・\n発展" as c1 #white
}
A -down-> B
B -down-> C
@enduml
