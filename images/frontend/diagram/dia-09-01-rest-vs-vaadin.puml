' REST と Vaadin の対比：Presentation 層だけが違う（09 章）
@startuml dia-09-01-rest-vs-vaadin
!include _common.iuml
left to right direction
rectangle "REST" as rest #f4f4f4 {
  rectangle "JSON の\nリクエスト" as r1 #white
  rectangle "学生コントローラ" as r2 #d6eaf8
  rectangle "学生を登録する\n（ユースケース）" as r3 #d5f5e3
  r1 --> r2
  r2 --> r3
}
rectangle "Vaadin" as vaadin #f4f4f4 {
  rectangle "入力欄・ボタン" as v1 #white
  rectangle "学生登録ビュー" as v2 #d6eaf8
  rectangle "学生を登録する\n（ユースケース）" as v3 #d5f5e3
  v1 --> v2
  v2 --> v3
}
note bottom of r3 : ユースケース以降は、同じ。\nPresentation 層だけが違う
rest -[hidden]down- vaadin
@enduml
