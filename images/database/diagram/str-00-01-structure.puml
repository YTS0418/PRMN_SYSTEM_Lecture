' データベース編の構成（00 章）：01 → 設計 → SQL → Java から使う
@startuml str-00-01-structure
!include ../../frontend/diagram/_common.iuml
top to bottom direction
rectangle "01\nデータベースとは" as d1 #white
rectangle "設計（02〜06 章）" as A #d6eaf8 {
  rectangle "02\n設計の流れ" as a0 #white
  rectangle "03\n概念設計" as a1 #white
  rectangle "04\n論理設計" as a2 #white
  rectangle "05\n正規化" as a3 #white
  rectangle "06\n物理設計" as a4 #white
  a0 -right-> a1
  a1 -right-> a2
  a2 -right-> a3
  a3 -right-> a4
}
rectangle "SQL（07〜11 章）" as B #d5f5e3 {
  rectangle "07\n環境構築" as b0 #white
  rectangle "08\nDDL" as b1 #white
  rectangle "09\n基本操作" as b2 #white
  rectangle "10\n応用" as b3 #white
  rectangle "11\nトランザクション" as b4 #white
  b0 -right-> b1
  b1 -right-> b2
  b2 -right-> b3
  b3 -right-> b4
}
rectangle "Java から使う（12 章）" as C #fff3cd {
  rectangle "12\nJDBC" as c0 #white
}
d1 -down-> A
A -down-> B
B -down-> C
@enduml
