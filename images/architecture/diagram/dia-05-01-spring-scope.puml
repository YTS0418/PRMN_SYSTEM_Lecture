' Spring に依存してよい範囲と、Domain（05 章）
@startuml dia-05-01-spring-scope
!include ../../frontend/diagram/_common.iuml
top to bottom direction
hide stereotype
skinparam rectangle<<scope>> {
  BackgroundColor white
  BorderColor #555555
  BorderStyle dashed
}
rectangle "Spring に依存してよい範囲" as S <<scope>> {
  rectangle "Presentation\n@RestController" as P #d6eaf8
  rectangle "Application\n@Service / @Transactional" as A #d5f5e3
  rectangle "Infrastructure\n@Repository / JdbcClient" as I #fff3cd
  P -right-> A
}
rectangle "Domain（Spring に依存しない）\n素の Java（学生 / 履修 / リポジトリのインタフェース）" as D #d5f5e3;line.bold
A --> D
I ..> D : 実装する
@enduml
